# Copy to .env to override config/settings.json. All values are optional.
# Only localhost Ollama hosts are accepted unless GST_ALLOW_REMOTE_OLLAMA=1 (not recommended).

GST_OLLAMA_MODEL=qwen2.5:7b-instruct
GST_OLLAMA_HOST=http://127.0.0.1:11434
GST_OLLAMA_TIMEOUT_S=180

# paddleocr | tesseract
GST_OCR_ENGINE=paddleocr
GST_OCR_FALLBACK_ENGINE=tesseract
# GST_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Where the database, uploaded copies, page images and logs are stored
GST_DATA_DIR=data

# Rounding tolerance for total reconciliation, in rupees
GST_AMOUNT_TOLERANCE=1.00

# per_file (one invoice per file) | per_page (every PDF page is its own invoice)
GST_PDF_MODE=per_file
